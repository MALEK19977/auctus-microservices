# ============================================================================
#  AUCTUS - environment template
#
#  Copy to .env and fill in real values. .env is gitignored and must never be
#  committed. Every variable below has a development default in the service's
#  application.yml, except JWT_SECRET, which has none by design.
# ============================================================================

# ---- Database --------------------------------------------------------------
DB_USERNAME=postgres
DB_PASSWORD=change-me
AUTH_DB_URL=jdbc:postgresql://localhost:5432/auth_db
CHEQUE_DB_URL=jdbc:postgresql://localhost:5432/cheque_db

# ---- Service discovery -----------------------------------------------------
EUREKA_USER=eureka
EUREKA_PASSWORD=change-me
EUREKA_URL=http://eureka:change-me@localhost:8761/eureka/

# ---- Authentication --------------------------------------------------------
# REQUIRED. The service will not issue tokens without it.
# Generate with:  openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRATION=3600000

# ---- Data locations --------------------------------------------------------
# Where the generated cheque dataset and enrolled signatures live.
AUCTUS_DATA_DIR=../../cheque_generator
# Where uploaded client documents, images and voice notes are written.
AUCTUS_UPLOAD_DIR=../../uploads

# ---- Inter-service URLs ----------------------------------------------------
OCR_SERVICE_URL=http://localhost:8083
QR_SERVICE_URL=http://localhost:8084
SIGNATURE_SERVICE_URL=http://localhost:8085
CLIENT_SERVICE_URL=http://localhost:8086

# ---- Tuning ----------------------------------------------------------------
# Signature match threshold. Measured on the generated dataset: genuine
# signatures score >= 0.79, skilled forgeries peak at 0.68.
SIGNATURE_THRESHOLD=0.72

# Path to the Python interpreter. Leave blank to auto-detect.
PYTHON_COMMAND=
# Tesseract binary, used by the OCR and QR pipelines.
TESSERACT_CMD=C:/Program Files/Tesseract-OCR/tesseract.exe
